# Copy this file to .env and fill in real values. Never commit .env.

# A long random string that Django uses to sign sessions and tokens.
SECRET_KEY=change-me-to-a-long-random-string

# True while developing, False on a public server.
DEBUG=True

# Comma-separated host names the site may be opened with. Add your PC's LAN IP to test on a phone.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database name, from the Supabase Session pooler details.
DB_NAME=your_db_name

# Database user, from the Supabase Session pooler details.
DB_USER=your_db_user

# Database password you chose for the Supabase project.
DB_PASSWORD=your_db_password

# Session pooler host name, from the Supabase Connect panel.
DB_HOST=your-pooler-host.example.com

# Session pooler port.
DB_PORT=5432

# Use "require" for Supabase; "prefer" or "disable" for a local PostgreSQL server.
DB_SSLMODE=require
